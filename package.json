{
  "name": "vasp-management-system",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "VASP 第一性原理计算项目管理系统 - 前端框架（Mock 数据演示）",
  "scripts": {
    "dev": "vite",
    "server": "python backend/run.py",
    "server:watch": "python -m uvicorn main:app --reload --host 0.0.0.0 --port 3001 --app-dir backend",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.22.5",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.6.3",
    "vite": "^7.3.6"
  }
}
